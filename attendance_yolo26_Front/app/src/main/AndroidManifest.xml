<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.YonamAttendance"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.ClassroomManageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SubjectDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SubjectListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ServerSettingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.RegisterStudentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AttendanceListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AttendanceCameraActivity"
            android:exported="false" />
        <activity
            android:name=".ui.StudentMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AdminMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.RoleSelectActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ClassroomSelectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
